Options -MultiViews
DirectoryIndex index.html

RewriteEngine On

# Serve real files and directories without rewriting them.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Map clean public URLs such as /about and /projects/johnson-bathroom to the
# corresponding files generated by Vinext (about.html, johnson-bathroom.html).
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /404.html

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/x-m4v "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(?:webp|png|jpe?g|svg|m4v|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  SetEnvIf Request_URI "^/_next/static/" immutable_asset
  Header set Cache-Control "public, max-age=31536000, immutable" env=immutable_asset
</IfModule>
