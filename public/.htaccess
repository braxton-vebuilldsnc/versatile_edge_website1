Options -MultiViews
DirectoryIndex index.html
DirectorySlash Off

RewriteEngine On
RewriteBase /

# Redirect retired, non-location WordPress pages only on the production hosts.
# Absolute targets combine legacy-path, scheme, and host normalization in one
# hop. City URLs are assigned only after their matching substantive page is
# approved; there are no wildcard location redirects.
RewriteCond %{HTTP_HOST} ^(?:www\.)?versatileedgellc\.com(?::[0-9]+)?$ [NC]
RewriteRule ^about-versatile-edge/?$ https://versatileedgellc.com/about [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(?:www\.)?versatileedgellc\.com(?::[0-9]+)?$ [NC]
RewriteRule ^services1/?$ https://versatileedgellc.com/services [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(?:www\.)?versatileedgellc\.com(?::[0-9]+)?$ [NC]
RewriteRule ^contact-versatile-edge-llc/?$ https://versatileedgellc.com/contact [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(?:www\.)?versatileedgellc\.com(?::[0-9]+)?$ [NC]
RewriteRule ^general-contractor-services-in-raleigh-nc/?$ https://versatileedgellc.com/service-areas/raleigh-nc [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(?:www\.)?versatileedgellc\.com(?::[0-9]+)?$ [NC]
RewriteRule ^versatile-edge-general-contractor-in-wake-forest-nc-kitchens-baths-additions-decks-more/?$ https://versatileedgellc.com/service-areas/wake-forest-nc [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(?:www\.)?versatileedgellc\.com(?::[0-9]+)?$ [NC]
RewriteRule ^general-contractor-in-apex-nc-kitchens-bath-additions-decks-more/?$ https://versatileedgellc.com/service-areas/apex-nc [R=301,L,NE]

# Direct requests for the exported error-document aliases must themselves be
# true 404 responses. REDIRECT_STATUS prevents the internal ErrorDocument
# subrequest for /404.html from re-entering this rule.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^404(?:\.html)?/?$ - [R=404,L]

# Prevent the two exact development hosts from being indexed. Neither
# production hostname can match these conditions, and no build-time
# environment flag is involved.
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Host "^staging\.versatileedgellc\.com(?::[0-9]+)?$" versatile_edge_development=1
  SetEnvIfNoCase Host "^targeting\.versatileedgellc\.com(?::[0-9]+)?$" versatile_edge_development=1
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=versatile_edge_development
</IfModule>

# BEGIN GENERATED ROUTE NORMALIZATION
# The post-build process inserts exact rules derived from exported indexable
# routes here. Do not maintain a route list by hand.
# END GENERATED ROUTE NORMALIZATION

# Normalize only the configured public hosts. The www rule always lands on the
# final HTTPS apex host. Forwarded-Proto avoids loops behind an HTTPS proxy.
RewriteCond %{HTTP_HOST} ^www\.versatileedgellc\.com(?::[0-9]+)?$ [NC]
RewriteRule ^ https://versatileedgellc.com%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^versatileedgellc\.com(?::[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://versatileedgellc.com%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^staging\.versatileedgellc\.com(?::[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://staging.versatileedgellc.com%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^targeting\.versatileedgellc\.com(?::[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://targeting.versatileedgellc.com%{REQUEST_URI} [R=301,L,NE]

# Serve real files without rewriting them.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Map clean public URLs such as /about and /projects/johnson-bathroom to the
# corresponding files generated by Vinext. This must run before the directory
# bypass because /projects and /services are both an HTML page and a directory.
# IONOS shared hosting does not reliably expose a filesystem path usable by -f
# here, so let Apache resolve the relative target and serve 404.html if absent.
RewriteCond %{REQUEST_URI} !\.[^/]+$
RewriteRule ^(.+?)/?$ $1.html [L]

# Preserve real asset directories after checking for a matching page above.
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

ErrorDocument 404 /404.html

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/x-m4v "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(?:webp|png|jpe?g|svg|m4v|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  SetEnvIf Request_URI "^/_next/static/" immutable_asset
  Header set Cache-Control "public, max-age=31536000, immutable" env=immutable_asset
</IfModule>
