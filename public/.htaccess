Options -MultiViews
DirectoryIndex index.html
DirectorySlash Off

RewriteEngine On
RewriteBase /

# Serve real files without rewriting them.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Map clean public URLs such as /about and /projects/johnson-bathroom to the
# corresponding files generated by Vinext. This must run before the directory
# bypass because /projects and /services are both an HTML page and a directory.
# IONOS shared hosting does not reliably expose a filesystem path usable by -f
# here, so let Apache resolve the relative target and serve 404.html if absent.
RewriteCond %{REQUEST_URI} !\.[^/]+$
RewriteRule ^(.+?)/?$ $1.html [L]

# Preserve real asset directories after checking for a matching page above.
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

ErrorDocument 404 /404.html

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/x-m4v "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(?:webp|png|jpe?g|svg|m4v|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  SetEnvIf Request_URI "^/_next/static/" immutable_asset
  Header set Cache-Control "public, max-age=31536000, immutable" env=immutable_asset
</IfModule>
